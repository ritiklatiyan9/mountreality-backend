# Core runtime (required; production startup fails closed when unsafe)
NODE_ENV=development
PORT=3000
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_POOL_MIN=2
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
RECEIPT_VERIFY_SECRET=
CORS_ORIGINS=http://localhost:5173
PUBLIC_VERIFY_URL=http://localhost:5173/verify-receipt

# Optional one-time platform-owner bootstrap for `npm run migrate:saas`.
# Use a unique 16+ character mixed-case, numeric, and symbol password, then
# remove both variables from the deployment environment after provisioning.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# Private object storage (required in production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Forecast Copilot (AI assistant on the Finance Forecast page)
# Optional — if OPENROUTER_API_KEY is unset, the assistant runs in
# deterministic-fallback-only mode (no AI call, still fully functional).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Compliance & Legal Control Centre
# Set to "off" only when a separate process owns the hourly scheduler.
COMPLIANCE_SCHEDULER=on
FRONTEND_URL=http://localhost:5173

# Email reminders reuse the existing SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS reminders reuse the existing SQS worker. Run `npm run worker:sms`.
AWS_SMS_QUEUE_URL=
AWS_SQS_REGION=ap-south-1

# WhatsApp is optional and requires an approved four-variable compliance
# template: recipient name, record title, due date, and reminder message.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANG=en_US
MSG91_COMPLIANCE_TEMPLATE=
