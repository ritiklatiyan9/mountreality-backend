# Forecast Copilot (AI assistant on the Finance Forecast page)
# Optional — if OPENROUTER_API_KEY is unset, the assistant runs in
# deterministic-fallback-only mode (no AI call, still fully functional).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Compliance & Legal Control Centre
# Set to "off" only when a separate process owns the hourly scheduler.
COMPLIANCE_SCHEDULER=on
FRONTEND_URL=http://localhost:5173

# Email reminders reuse the existing SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS reminders reuse the existing SQS worker. Run `npm run worker:sms`.
AWS_SMS_QUEUE_URL=
AWS_SQS_REGION=ap-south-1

# WhatsApp is optional and requires an approved four-variable compliance
# template: recipient name, record title, due date, and reminder message.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANG=en_US
MSG91_COMPLIANCE_TEMPLATE=
