# Forecast Copilot (AI assistant on the Finance Forecast page)
# Optional — if OPENROUTER_API_KEY is unset, the assistant runs in
# deterministic-fallback-only mode (no AI call, still fully functional).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
