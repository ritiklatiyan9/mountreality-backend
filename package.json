{
  "name": "pern-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "predev": "echo 'Auto migrations disabled on startup; run npm run start:with-migrations for full startup migrations'",
    "dev": "nodemon src/server.js",
    "db:setup": "node src/scripts/setupDb.js && npm run migrate:accounting && npm run migrate:saas",
    "migrate:saas": "node src/migrations/079_saas_multitenancy.js",
    "migrate:plot-documents": "node src/migrations/059_plot_documents.js",
    "migrate:dms": "node src/migrations/069_dms_documents.js",
    "migrate:member-kyc-document-field": "node src/migrations/072_member_kyc_document_field.js",
    "migrate:member-categories": "node src/migrations/003_member_categories.js",
    "migrate:balance-sheet": "node src/migrations/073_balance_sheet_performance.js",
    "migrate:application-settings": "node src/migrations/074_application_settings.js",
    "migrate:registry-payment-invariants": "node src/migrations/075_registry_payment_plot_invariants.js",
    "migrate:transaction-person-mapping": "node src/migrations/076_transaction_person_mapping.js",
    "migrate:sms-reminder-log": "node src/migrations/078_sms_reminder_log.js",
    "migrate:cashflow-sync-coverage": "node src/migrations/080_cashflow_sync_full_coverage.js",
    "migrate:ledger-bucket": "node src/migrations/081_unified_ledger_bucket.js",
    "migrate:farmer-split-invariant": "node src/migrations/082_farmer_split_invariant.js",
    "migrate:firm-single-ledger-post": "node src/migrations/083_firm_single_ledger_post.js",
    "migrate:firm-transfer-pairs": "node src/migrations/084_firm_transfer_pair_invariant.js",
    "migrate:farmer-land-broker-commission": "node src/migrations/085_farmer_land_unit_and_broker_commission.js",
    "migrate:member-role": "node src/migrations/086_member_role.js",
    "migrate:plan-pricing": "node src/migrations/087_update_plan_pricing.js",
    "migrate:compliance": "node src/migrations/088_compliance_legal_control_centre.js && node src/migrations/089_compliance_notification_centre.js",
    "migrate:compliance:down": "node src/migrations/089_compliance_notification_centre.js --down && node src/migrations/088_compliance_legal_control_centre.js --down",
    "seed:compliance": "node src/scripts/seedComplianceDemo.js",
    "migrate:accounting": "npm run migrate:cashflow-sync-coverage && npm run migrate:ledger-bucket && npm run migrate:farmer-split-invariant && npm run migrate:firm-single-ledger-post && npm run migrate:firm-transfer-pairs && npm run migrate:farmer-land-broker-commission && npm run migrate:member-role && npm run migrate:plan-pricing",
    "check:ledger": "node src/checks/ledger-consistency.mjs",
    "test:accounting": "node --test test/accounting-policy.test.mjs",
    "test:finance-forecast": "node --test test/finance-forecast.test.mjs",
    "test:compliance": "node --test test/compliance-*.test.mjs",
    "worker:sms": "node src/workers/smsWorker.js",
    "start:with-migrations": "npm run migrate:plot-documents && npm run migrate:dms && npm run migrate:member-kyc-document-field && npm run migrate:member-categories && npm run migrate:balance-sheet && npm run migrate:application-settings && npm run migrate:registry-payment-invariants && npm run migrate:transaction-person-mapping && npm run migrate:sms-reminder-log && npm run migrate:accounting && npm run migrate:saas && npm run migrate:compliance && node src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/client-sqs": "^3.699.0",
    "@aws-sdk/lib-storage": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@graphql-tools/schema": "^10.0.32",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "firebase-admin": "^14.1.0",
    "graphql": "^16.13.2",
    "graphql-http": "^1.22.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "razorpay": "^2.9.8",
    "react-dropzone": "^15.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "fast-xml-parser": "4.5.6",
    "semver": "7.7.2"
  }
}
